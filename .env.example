# Slack Socket Mode credentials
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me

# OpenAI-compatible inference endpoint
INFERENCE_ROUTER_BASE_URL=https://your-inference-endpoint.example.com
INFERENCE_ROUTER_API_KEY=replace-me
INFERENCE_ROUTER_MODEL=replace-with-a-model-id

# Optional durable thread history/settings (memory needs no URL).
# SQLite example: sqlite:////tmp/thread-state.db
THREAD_STATE_BACKEND=memory
THREAD_STATE_URL=

# Optional installed plugins, loaded by entry-point name in this order.
SLACK_AGENT_RUNTIME_PLUGINS=

# Optional built-ins: auto, empty, or a comma-separated subset of
# mcp,coding,reviews,security_audit. Core conversation plugins always load.
SLACK_AGENT_RUNTIME_BUILTIN_PLUGINS=auto

# Optional direct MCP servers. Copy an example from examples/mcp/ to mcp.json.
SLACK_AGENT_RUNTIME_MCP_CONFIG=
SLACK_AGENT_RUNTIME_MCP_MAX_STEPS=8
SLACK_AGENT_RUNTIME_MCP_TOOL_TIMEOUT_SECONDS=30
SLACK_AGENT_RUNTIME_MCP_APPROVAL_TIMEOUT_SECONDS=300
SLACK_AGENT_RUNTIME_MCP_MAX_RESULT_CHARS=20000
# Credentials used by the bundled examples/mcp/ configurations:
# GITHUB_MCP_TOKEN=
# LINEAR_MCP_TOKEN=
# NOTION_MCP_HEADERS={"Authorization":"Bearer YOUR_NOTION_TOKEN","Notion-Version":"2022-06-28"}
# SLACK_AGENT_RUNTIME_MCP_CONFIG=mcp.json
# SLACK_MCP_BOT_TOKEN=
# SLACK_MCP_TEAM_ID=

# Optional GitHub Actions coding layer. Both token and allowlist are required.
# Use exact owner/repository names; only listed repositories can receive jobs.
# SLACK_AGENT_RUNTIME_GITHUB_TOKEN=github_pat_replace_me
# SLACK_AGENT_RUNTIME_CODING_REPOSITORIES=owner/repository,owner/another-repository
# SLACK_AGENT_RUNTIME_GITHUB_API_URL=https://api.github.com
# SLACK_AGENT_RUNTIME_CODING_EVENT_TYPE=slack_agent_coding_job
# SLACK_AGENT_RUNTIME_CODING_WORKFLOW_FILENAME=coding-agent.yml
# SLACK_AGENT_RUNTIME_CODING_MAX_PROMPT_CHARS=8000
# SLACK_AGENT_RUNTIME_REVIEW_EVENT_TYPE=slack_agent_pr_review
# SLACK_AGENT_RUNTIME_REVIEW_WORKFLOW_FILENAME=pr-review.yml
# SLACK_AGENT_RUNTIME_REVIEW_PAGE_SIZE=10
# SLACK_AGENT_RUNTIME_SECURITY_AUDIT_EVENT_TYPE=slack_agent_security_audit
# SLACK_AGENT_RUNTIME_SECURITY_AUDIT_WORKFLOW_FILENAME=security-audit.yml

# Optional observability. Without an OTLP endpoint telemetry remains a safe no-op.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Standard OTLP/gRPC options, interpreted by the OpenTelemetry exporters.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_INSECURE=

# Optional cost estimation; no pricing is built into the application.
# JSON shape: {"model-id":{"input_usd_per_million_tokens":0,"output_usd_per_million_tokens":0}}
INFERENCE_ROUTER_MODEL_PRICING_JSON=

# Policy (comma-separated Slack IDs; empty allowlists are unrestricted)
SLACK_AGENT_RUNTIME_ALLOWED_WORKSPACE_IDS=
SLACK_AGENT_RUNTIME_ALLOWED_CHANNEL_IDS=
SLACK_AGENT_RUNTIME_ALLOWED_USER_IDS=
# Empty means nobody may change model or generation settings
SLACK_AGENT_RUNTIME_ADMIN_USER_IDS=

# Per-user in-memory limits; zero disables each limit
SLACK_AGENT_RUNTIME_REQUEST_LIMIT=0
SLACK_AGENT_RUNTIME_REQUEST_WINDOW_SECONDS=60
SLACK_AGENT_RUNTIME_TOKEN_BUDGET=0
SLACK_AGENT_RUNTIME_TOKEN_WINDOW_SECONDS=3600
SLACK_AGENT_RUNTIME_MAX_CONCURRENT_REQUESTS=0

# Minimum delay between edits to the single in-progress Slack message
SLACK_AGENT_RUNTIME_STREAM_UPDATE_INTERVAL_SECONDS=1
